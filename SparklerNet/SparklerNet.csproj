<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Core Project Settings -->
        <TargetFrameworks>net9.0</TargetFrameworks>
        <TargetFrameworks Condition=" '$(NetCoreAppMaximumVersion)' >= '10.0'">net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Version Information -->
        <Version>0.9.8-dev</Version>

        <!-- NuGet Package Configuration -->
        <!-- Basic Info -->
        <PackageId>SparklerNet</PackageId>
        <Authors>Dennis Gu</Authors>
        <Description>An open-source Sparkplug Client Library for .NET 9.0, .NET 10.0 or later</Description>
        <PackageTags>C# .NET MQTT Sparkplug IIoT Industry4.0</PackageTags>
        <PackageSupportedFrameworks>.NETCoreApp,Version=v9.0;.NETCoreApp,Version=v10.0</PackageSupportedFrameworks>

        <!-- Documentation & Metadata -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- Link Information -->
        <PackageProjectUrl>https://github.com/longkerdandy/SparklerNet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/longkerdandy/SparklerNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- Build Configuration -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <!-- Package References -->
        <PackageReference Include="Google.Protobuf" Version="3.33.4" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.2.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
        <PackageReference Include="MQTTnet" Version="5.0.1.1416" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Folders and Files -->
        <Folder Include="Core\Protobuf\" />

        <!-- Include the README file in the NuGet package -->
        <None Include="..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
